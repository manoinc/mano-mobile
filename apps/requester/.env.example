# Personal overrides on top of config/dev.json. Copy to .env (git-ignored), uncomment what you change, then:
#   flutter run --dart-define-from-file=../../config/dev.json --dart-define-from-file=.env
# The later file wins key by key. Values are compiled into the binary: never put server secrets here.
# A blank value (KEY=) overrides too, so leave unused keys commented out.

# mano-gateway GraphQL endpoint, e.g. your Mac's LAN IP for a physical iPhone
# MANO_GATEWAY=http://192.168.1.10:8082/graphql

# mano-auth SuperTokens API domain
# SUPERTOKENS_API_DOMAIN=http://localhost:3001

# mano-auth's Google web client ID
# GOOGLE_SERVER_CLIENT_ID=
