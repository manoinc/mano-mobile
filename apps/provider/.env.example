# Personal overrides: copy to .env (git-ignored) and run: flutter run --dart-define-from-file=.env
# Shared defaults need no copy: config/dev.json (local) and config/prod.json (release).
# Values are compiled into the app binary: never put server-side secrets here.

# mano-gateway GraphQL endpoint (required)
MANO_GATEWAY=http://localhost:8082/graphql

# mano-auth SuperTokens API domain; blank leaves sign-in off
SUPERTOKENS_API_DOMAIN=http://localhost:3001

# mano-auth's Google web client ID; blank turns Google sign-in off
GOOGLE_SERVER_CLIENT_ID=

# Base of the professional invite link; the code is appended
MANO_INVITE_LINK_BASE=https://manoapp.co/r/

# Debug only: the mock identity check approves on send
MANO_APPROVE_IDENTITY=false
